# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
# Include .onrender.com and .vercel.app for production deployments
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app

# Database (SQLite for dev, PostgreSQL for production)
USE_POSTGRES=True
DATABASE_URL=postgresql://user:password@localhost:5432/supportgenie

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (use console backend for dev, smtp for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=SupportGenie AI <noreply@supportgenie.ai>

# CORS — list explicit origins. CORS_ALLOW_ALL_ORIGINS is NOT set because
# it is incompatible with CORS_ALLOW_CREDENTIALS=True (browsers reject wildcard + credentials).
# The settings.py regex already covers *.vercel.app and *.onrender.com.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# Frontend URL (used in password reset emails)
FRONTEND_URL=https://your-app.vercel.app

# Media
MEDIA_ROOT=media/

# Vector Store
VECTOR_STORE_PATH=vector_store/faiss_index
